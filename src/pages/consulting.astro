---
import Base from '../layouts/Base.astro';
import { AUTHOR, SITE, TEAM } from '../config';
import { personSchema } from '../lib/schema';

const linkedin = AUTHOR.sameAs.find((u) => u.includes('linkedin'));

const problems = [
  { title: "A new starter's first week", body: "Someone starts on Monday and their account turns up on Wednesday, or it's there but half their apps aren't. They spend the week asking for access instead of getting on with the job." },
  { title: 'Setting people up', body: "The quickest way to set someone up is to copy a colleague with a similar job. The catch is that they get everything that colleague has picked up over the years as well, including things they shouldn't have." },
  { title: 'When someone leaves', body: "If HR doesn't tell IT, or tells them late, the account stays active. It's surprisingly common for a former employee's email and apps to keep working for weeks." },
  { title: 'When someone asks', body: 'Auditors, insurers and larger clients want to know who can get into what, and who signed off on it. Pulling that together from old tickets and inboxes can take days.' },
];

const lifecycle = [
  { name: 'Before they start', body: 'Their account is created from the payroll record, with their role, site and manager worked out. The manager hears who is coming, and a ticket goes out for the laptop.' },
  { name: 'First day', body: 'The account switches on for their start date, the manager gets a one-time code to sign them in, and everything their role needs is already there.' },
  { name: 'Changing roles', body: 'A new title or site in payroll adds the new access and removes the old after a short handover. Anyone with manual work to do is told.' },
  { name: 'Leaving', body: 'On their last day access is removed and the account is switched off, with the mailbox kept for whoever takes over. Urgent exits run on demand.' },
  { name: 'All along', body: 'Extra access is requested and approved with an expiry date, reviewed regularly, and recorded, so the audit answer is always ready.' },
];

const capabilities = [
  { title: 'Connects to your HR or payroll system', body: 'Including HR and payroll systems that Entra ID has no built-in connector for.' },
  { title: 'One clean copy of your people data', body: 'Kept current, with a history of every change for when audit asks.' },
  { title: 'Turns payroll data into roles and sites', body: 'Job titles grouped into roles, location codes matched to real places.' },
  { title: 'Handles the awkward cases', body: 'Late starters, late terminations and rehires still get the right treatment.' },
];

const stages = [
  {
    name: 'Readiness review',
    outcome: 'A short report, a recommended design and a fixed quote.',
    body: "We look at the four things that decide how big the job is: your HR and payroll data, your Active Directory if you still have one, your Microsoft 365 and Entra ID setup including licensing, and how people are set up and removed today. Most of the risk sits in that data, so that's where we spend the most time. You can stop here and keep the report.",
  },
  {
    name: 'Design',
    outcome: 'A signed-off design, so scope and price are settled.',
    body: "Together we decide what drives access, what people get automatically and what they ask for, when accounts are switched on and off, and how it connects to your other systems. Every decision is written down in plain language, along with the options we didn't take and why.",
  },
  {
    name: 'Build and switch on',
    outcome: 'Joiners, movers and leavers running automatically.',
    body: "We build it alongside your current process and test it against your real HR and payroll data, not tidy samples. Nothing changes for your people until it's ready, and then we switch it on a group at a time so any surprises stay small.",
  },
  {
    name: 'Handover',
    outcome: 'Something your team can run without us.',
    body: "Your IT team, or your managed service provider, gets clear documentation and a walk-through of how it all fits together. If you'd like us on call afterwards, we can agree that separately.",
  },
];

const work = [
  { who: 'Industrial business, Australia and New Zealand', what: 'Payroll-driven provisioning into Active Directory and Entra ID, automated joiners, movers and leavers, rule-based access, and ServiceNow integration.' },
  { who: 'Australian financial institution', what: 'Identity governance and privileged access designed together, from HR-driven provisioning through to BeyondTrust.' },
  { who: 'A university and a healthcare distributor', what: 'Privileged access management with BeyondTrust.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: SITE.name,
    logo: `${SITE.url}/favicon.svg`,
    url: `${SITE.url}/consulting/`,
    email: AUTHOR.email,
    areaServed: ['Australia', 'New Zealand'],
    employee: [personSchema(), { '@type': 'Person', name: 'Lauren Battaglia', jobTitle: 'COO', image: `${SITE.url}/images/lauren-battaglia.jpg` }],
    description:
      'Automated onboarding, role changes and offboarding for small and medium businesses, driven by HR and payroll data, using Microsoft Entra ID Governance.',
  },
];
---
<Base title="Entra ID Governance consulting: automated onboarding and offboarding" description="We help small and medium businesses in Australia and New Zealand let their HR or payroll system run access: onboarding, role changes and offboarding, automated with Microsoft Entra ID Governance." jsonLd={jsonLd} image="/og/consulting.png">
  <div class="wrap consult">
    <header class="hero-c">
      <h1>Let your HR or payroll system run access.</h1>
      <p>Frost Eagle is a small identity team that automates how small and medium businesses in Australia and New Zealand set people up, move them and switch them off, straight from their HR or payroll system. It runs on Microsoft Entra ID Governance, an add-on to the Microsoft licences many businesses already have.</p>
      <p class="hero-actions"><a class="button" href={`mailto:${AUTHOR.email}`}>Email {AUTHOR.email}</a></p>
    </header>

    <section aria-labelledby="problems">
      <h2 id="problems">Where it usually goes wrong</h2>
      <p class="section-lead">In a lot of growing businesses, starters and leavers are handled by one or two people in IT, or by the managed service provider, working from emails and tickets. These are the places it tends to slip.</p>
      <div class="problem-grid">
        {problems.map((p) => (
          <div class="problem">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <p class="aside">The frustrating part is that your HR or payroll system usually has all of this already: who's starting, who's moving, who's leaving, and on what date. It just isn't connected to anything that grants access. We connect it, and automate everything that follows.</p>
    </section>

    <section aria-labelledby="changes">
      <h2 id="changes">What gets automated</h2>
      <p class="section-lead">Once your HR or payroll data drives access, every step of a person's time with you is automated. Nobody has to remember to do any of it.</p>
      <ol class="timeline">
        {lifecycle.map((s) => (
          <li>
            <span class="dot" aria-hidden="true" />
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="hrdata" class="split">
      <div>
        <h2 id="hrdata">Getting your HR and payroll data in</h2>
        <p>Everything above starts with your people data. Where your HR or payroll system doesn't connect straight to Entra ID, or the data needs shaping first, we bring in an HR integration platform we've run in production, licensed through a partner.</p>
        <p>It sits between your HR or payroll system and Entra ID and hands over a complete, consistent record every time. If your system already connects cleanly, you won't need it.</p>
      </div>
      <dl class="caps">
        {capabilities.map((c) => (
          <div>
            <dt>{c.title}</dt>
            <dd>{c.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="how">
      <h2 id="how">How we run a project</h2>
      <p class="section-lead">Four stages, each at a fixed price agreed before it starts, and you can stop after any of them. Open a stage for the detail.</p>
      <div class="stages">
        {stages.map((s, i) => (
          <details class="stage">
            <summary>
              <span class="num">{i + 1}</span>
              <span class="stage-name">{s.name}</span>
              <span class="stage-outcome">{s.outcome}</span>
              <span class="more" aria-hidden="true">Read more</span>
            </summary>
            <p>{s.body}</p>
          </details>
        ))}
      </div>
    </section>

    <section aria-labelledby="work">
      <h2 id="work">Recent work</h2>
      <p class="section-lead">With the names left out. The <a href="/articles/">articles</a> on this site come out of the same work.</p>
      <figure class="quote">
        <blockquote><p>Exceptional and impeccable work from start to finish. Attention to detail and expertise at what they do.</p></blockquote>
        <figcaption>Head of IT, industrial business in Australia and New Zealand</figcaption>
      </figure>
      <div class="work-grid">
        {work.map((w) => (
          <div class="work">
            <h3>{w.who}</h3>
            <p>{w.what}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="team">
      <h2 id="team">Who you'll work with</h2>
      <div class="team-grid">
        {TEAM.map((t) => (
          <div class="person">
            <img src={t.photo} alt={`Portrait of ${t.name}`} width="640" height="640" loading="lazy" />
            <div>
              <h3>{t.name}</h3>
              <p class="role">{t.role}</p>
              <p><a href={`/about/#${t.slug}`}>About {t.name.split(' ')[0]}</a></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="contact" aria-labelledby="talk">
      <h2 id="talk">Start with a conversation</h2>
      <p>Tell us roughly how many people you have, which HR or payroll system you use, whether you still run Active Directory, and what's prompting you to look at this now.</p>
      <p class="contact-actions">
        <a class="button light" href={`mailto:${AUTHOR.email}`}>Email {AUTHOR.email}</a>
        {linkedin && <a class="text-link" href={linkedin} rel="me">or message {AUTHOR.name.split(' ')[0]} on LinkedIn</a>}
      </p>
    </section>
  </div>
</Base>

<script>
  // On devices with a mouse, open a stage while it's hovered. Click and keyboard still work everywhere.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('details.stage').forEach((d) => {
      let pinned = false;
      d.addEventListener('mouseenter', () => { if (!d.open) d.open = true; });
      d.addEventListener('mouseleave', () => { if (!pinned) d.open = false; });
      d.querySelector('summary')?.addEventListener('click', (e) => {
        e.preventDefault();
        pinned = !pinned;
        d.open = pinned || d.matches(':hover');
      });
    });
  }
</script>

<style>
  .consult section {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .consult h2 {
    font-size: clamp(1.7rem, 3vw, 2.1rem);
    font-weight: 720;
  }

  .consult h3 {
    font-size: 1.15rem;
    font-weight: 680;
  }

  .section-lead {
    margin: 0.8rem 0 0;
    max-width: 40rem;
    color: var(--slate);
  }

  /* hero */
  .hero-c {
    padding-top: clamp(3rem, 8vw, 5.5rem);
  }

  .hero-c h1 {
    font-size: clamp(2.5rem, 6vw, 4.3rem);
    font-weight: 760;
    letter-spacing: -0.035em;
    line-height: 1.03;
    max-width: 17ch;
  }

  .hero-c p {
    max-width: 40rem;
    font-size: 1.22rem;
    color: var(--slate);
    margin: 1.4rem 0 0;
  }

  .hero-c .hero-actions {
    margin-top: 2rem;
  }

  .button {
    display: inline-block;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.02rem;
    padding: 0.8rem 1.3rem;
    background: var(--ink);
    color: var(--frost);
    text-decoration: none;
    border-radius: 3px;
  }

  .button:hover {
    background: var(--glacier-deep);
    color: var(--frost);
    text-decoration: none;
  }

  .button.light {
    background: var(--frost);
    color: var(--ink);
  }

  .button.light:hover {
    background: #ffffff;
    color: var(--ink);
  }

  /* problems */
  .problem-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 3rem;
    margin-top: 2rem;
  }

  .problem {
    border-top: 2px solid var(--ink);
    padding: 1.1rem 0 1.6rem;
  }

  .problem p,
  .work p {
    margin: 0.45rem 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .aside {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: 1.12rem;
  }

  /* lifecycle timeline */
  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.6rem;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 7px;
    /* stop at the last dot, which sits at the left edge of the last column */
    right: calc((100% - 4 * 1.6rem) / 5 - 9px);
    height: 2px;
    background: var(--glacier);
  }

  .timeline li {
    position: relative;
  }

  .timeline .dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--glacier);
    margin-bottom: 1.1rem;
    position: relative;
  }

  .timeline li:last-child .dot {
    background: var(--talon);
  }

  .timeline p {
    margin: 0.5rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }

  /* HR data split */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  .split p {
    margin: 1rem 0 0;
  }

  .caps {
    margin: 0.4rem 0 0;
  }

  .caps div {
    border-top: 1px solid var(--rule);
    padding: 1rem 0;
  }

  .caps div:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .caps dt {
    font-family: var(--sans);
    font-weight: 650;
    font-size: 1.08rem;
  }

  .caps dd {
    margin: 0.3rem 0 0;
    color: var(--slate);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  /* project stages */
  .stages {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
    align-items: start;
  }

  .stage {
    border-top: 2px solid var(--glacier);
    padding-top: 1rem;
  }

  .stage summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    gap: 0.4rem;
    font-family: var(--sans);
  }

  .stage summary::-webkit-details-marker {
    display: none;
  }

  .num {
    font-weight: 700;
    color: var(--glacier);
    font-size: 1rem;
  }

  .stage-name {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }

  .stage-outcome {
    font-size: 1rem;
    color: var(--slate);
    line-height: 1.45;
  }

  .more {
    font-size: 0.92rem;
    color: var(--glacier);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    margin-top: 0.2rem;
  }

  .stage[open] .more {
    display: none;
  }

  .stage[open] {
    border-top-color: var(--talon);
  }

  .stage p {
    margin: 0.9rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* testimonial */
  .quote {
    margin: 2rem 0 1.5rem;
    max-width: 44rem;
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.6vw, 1.9rem);
    line-height: 1.35;
    font-style: italic;
    color: var(--ink);
  }

  .quote figcaption {
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--slate);
  }

  /* recent work */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin-top: 2rem;
  }

  .work {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }

  /* team */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 3rem;
    margin-top: 2rem;
    max-width: 52rem;
  }

  .person {
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  .person img {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .person .role {
    margin: 0.2rem 0 0;
    font-family: var(--sans);
    color: var(--glacier);
    font-weight: 600;
  }

  .person p:last-child {
    margin: 0.6rem 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* contact band */
  .contact {
    background: var(--ink);
    color: var(--frost);
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 4px;
  }

  .contact h2 {
    color: var(--frost);
  }

  .contact p {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: #c9d6de;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem !important;
  }

  .text-link {
    color: var(--frost);
    font-family: var(--sans);
  }

  .text-link:hover {
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .timeline {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 2rem;
    }

    .timeline::before {
      top: 4px;
      bottom: 1.5rem;
      left: 7px;
      right: auto;
      width: 2px;
      height: auto;
    }

    .timeline li {
      padding-bottom: 1.5rem;
    }

    .timeline .dot {
      position: absolute;
      left: -2rem;
      top: 4px;
    }

    .stages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .split {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .work-grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .problem-grid,
    .stages {
      grid-template-columns: 1fr;
    }
  }
</style>

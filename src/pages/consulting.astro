---
import Base from '../layouts/Base.astro';
import { AUTHOR, ENQUIRY_MAILTO, SITE, TEAM } from '../config';
import { personSchema } from '../lib/schema';

const linkedin = AUTHOR.sameAs.find((u) => u.includes('linkedin'));

const enquiry = ENQUIRY_MAILTO;

const problems = [
  { title: 'New starters waiting for access', body: "When accounts are set up by hand, a new starter's first few days often go on chasing access to email, apps and shared files. That's lost time for them and their manager, and not the first impression most businesses want to give." },
  { title: 'Access copied from a colleague', body: "Setting someone up by mirroring a colleague in a similar role is quick, but it also passes on whatever that colleague has collected over the years. Over time, people end up with more access than their job needs." },
  { title: 'Accounts left active after people leave', body: "If IT isn't told about a departure, or hears about it late, the account can stay active for days or weeks. For many businesses this is one of the more serious risks in a manual process." },
  { title: 'Answering audit and insurance questions', body: 'Auditors, cyber insurers and larger customers increasingly ask who has access to what, and who approved it. Without a central record, putting that answer together from tickets and inboxes can take days.' },
];

const lifecycle = [
  { name: 'Before they start', body: "An account is created from the payroll record, with the person's role, site and manager already set. Their manager is notified, and a request can go out for equipment such as a laptop." },
  { name: 'First day', body: 'The account is switched on in time for their start date, and their manager receives a one-time code to help them sign in. The access their role needs is in place from the start.' },
  { name: 'Changing roles', body: 'When a new title or site is recorded in payroll, the new access is added and the previous access is removed after a short handover period. Anyone with manual steps to complete is notified.' },
  { name: 'Leaving', body: 'On their last day, access is removed and the account is disabled, while the mailbox is kept for whoever picks up their work. Urgent departures can be actioned immediately.' },
  { name: 'Throughout', body: 'Additional access is requested and approved with an expiry date, reviewed regularly and recorded, so audit questions can be answered with confidence.' },
];

const exceptions = [
  { title: 'New starters entered late', body: "Occasionally a new hire is only entered into payroll on the day they start. The design allows for this, so they're still set up that day rather than being missed because their start date has already passed." },
  { title: 'Urgent departures', body: 'When someone needs to leave immediately, the leaver process can be run on demand, removing access straight away without waiting for payroll to be updated.' },
  { title: 'Leavers with particular requirements', body: "Garden leave, executives whose accounts need different treatment, and the specific rules in your own leaver process are recorded on the person's record, so the automation can apply the right handling to each of them." },
  { title: 'Multiple countries and existing staff', body: 'Start and finish dates are applied at the correct local time in each country you operate in. Existing staff are brought in as part of the rollout, so your current workforce benefits as well as new starters.' },
];

const capabilities = [
  { title: 'Connects to your HR or payroll system', body: 'Including HR and payroll systems that Entra ID has no built-in connector for.' },
  { title: 'One clean copy of your people data', body: 'Kept current, with a history of every change for when audit asks.' },
  { title: 'Turns payroll data into roles and sites', body: 'Job titles grouped into roles, location codes matched to real places.' },
  { title: 'Handles the awkward cases', body: 'Late starters, late terminations and rehires still get the right treatment.' },
];

const work = [
  { who: 'Australian financial institution', what: 'Identity governance and privileged access designed together, from HR-driven provisioning through to BeyondTrust.' },
  { who: 'A university and a healthcare distributor', what: 'Privileged access management with BeyondTrust.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: SITE.name,
    logo: `${SITE.url}/favicon.svg`,
    url: `${SITE.url}/consulting/`,
    email: AUTHOR.email,
    areaServed: ['Australia', 'New Zealand'],
    employee: [personSchema(), { '@type': 'Person', name: 'Lauren Battaglia', jobTitle: 'COO', image: `${SITE.url}/images/lauren-battaglia.jpg` }],
    description:
      'Automated onboarding, role changes and offboarding for mid-sized businesses, driven by HR and payroll data, using Microsoft Entra ID Governance.',
  },
];
---
<Base title="Entra ID Governance consulting: automated onboarding and offboarding" description="We help mid-sized businesses in Australia and New Zealand let their HR or payroll system run access: onboarding, role changes and offboarding, automated with Microsoft Entra ID Governance." jsonLd={jsonLd} image="/og/consulting.png">
  <div class="wrap consult">
    <header class="hero-c">
      <h1>Onboarding and offboarding, driven by your HR or payroll system</h1>
      <p>Frost Eagle helps mid-sized businesses in Australia and New Zealand connect their HR or payroll system to Microsoft Entra ID, so that accounts and access are created, changed and removed as people join, move and leave. The work builds on Microsoft Entra ID Governance, which adds to the Microsoft licences many businesses already hold, and is delivered at a fixed price.</p>
      <p class="proof">Most recently, we delivered this for an industrial business across Australia and New Zealand: about 5,000 staff on Affinity payroll, hybrid Active Directory and Entra ID, with ServiceNow handling the manual steps. <a href="/case-studies/industrial-australia-new-zealand/">Read the case study</a></p>
      <p class="hero-actions"><a class="button" href={enquiry}>Discuss your onboarding process</a><span class="cta-note">A free 45-minute conversation, with no obligation.</span></p>
    </header>

    <section aria-labelledby="problems">
      <h2 id="problems">Where manual processes tend to fall short</h2>
      <p class="section-lead">In many growing businesses, joiners and leavers are handled by a small IT team or a managed service provider, working from emails and tickets. It generally works, but a few areas become costly or risky as the business grows.</p>
      <div class="problem-grid">
        {problems.map((p) => (
          <div class="problem">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <p class="aside">In most cases the information needed to address this already exists. Your HR or payroll system knows who is starting, who is changing roles and who is leaving, and when. Our work is to connect that information to Entra ID and automate the steps that follow.</p>
    </section>

    <section aria-labelledby="fit">
      <h2 id="fit">Where this makes financial sense</h2>
      <p class="section-lead">Automation pays for itself fastest where joiners, movers and leavers take up real time or carry real risk. That's usually the case if several of these apply to you:</p>
      <ul class="fit-list">
        <li>You hire regularly, or take on seasonal or project staff in batches.</li>
        <li>Your people work across several sites, or in more than one country.</li>
        <li>You still run Active Directory alongside Microsoft 365.</li>
        <li>Your IT team or managed service provider spends a noticeable share of its week on setting people up and removing them.</li>
        <li>Auditors, insurers or customers are asking how you control access.</li>
      </ul>
      <p class="aside">Projects usually make sense from around 500 staff. Our largest recent one covered about 5,000, and the scope and price scale with the size of the organisation.</p>
    </section>

    <section aria-labelledby="changes">
      <h2 id="changes">What the automation covers</h2>
      <p class="section-lead">Once your HR or payroll data is driving access, the routine steps across a person's time with you are handled consistently and on time. This is what that typically looks like, and the detail is agreed with you during design.</p>
      <ol class="timeline">
        {lifecycle.map((s) => (
          <li>
            <span class="dot" aria-hidden="true" />
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="exceptions">
      <h2 id="exceptions">Planning for the exceptions</h2>
      <p class="section-lead">No HR process runs perfectly, and every organisation has its own rules for how particular people should be handled. We plan for these cases from the outset, and the examples below come from recent projects.</p>
      <div class="problem-grid">
        {exceptions.map((p) => (
          <div class="problem">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <p class="aside">Technical failures are planned for in the same way. If records are missing from a payroll feed, nobody is switched off as a result; accounts are only disabled from a real leave date. Microsoft's provisioning service retries failed changes and logs every attempt, and before handover we agree who in your team or your managed service provider is notified when something needs attention.</p>
    </section>

    <section aria-labelledby="hrdata" class="split">
      <div>
        <h2 id="hrdata">Getting your HR and payroll data in</h2>
        <p>All of this depends on good people data. Where your HR or payroll system can't connect directly to Entra ID, or the data needs preparing first, we use an HR integration platform we have run in production, licensed through a partner.</p>
        <p>It sits between your HR or payroll system and Entra ID and makes sure each record arrives complete and consistent. If your system already connects cleanly, it isn't needed.</p>
        <p>It's a SaaS platform hosted in Microsoft Azure in Australia, with each customer's data kept separate. Its licence is billed separately from your Microsoft licences.</p>
        <p>Payroll and HR systems we've delivered against include Affinity, MicroPay and Connx. If yours is one we haven't worked with, discovery checks whether it has an API or a scheduled export, which fields it holds and how reliably they're kept up to date. That way you'll know whether it can drive access before anything is quoted.</p>
      </div>
      <dl class="caps">
        {capabilities.map((c) => (
          <div>
            <dt>{c.title}</dt>
            <dd>{c.body}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="work">
      <h2 id="work">Recent work</h2>
      <p class="section-lead">Client names are withheld. Many of the <a href="/articles/">articles</a> on this site draw on the same projects.</p>
      <article class="case">
        <h3>Industrial business across Australia and New Zealand</h3>
        <p class="case-meta">About 5,000 staff, around 66 sites in two countries, Affinity payroll, hybrid Active Directory and Entra ID, ServiceNow</p>
        <div class="case-body">
          <div>
            <h4>What we built</h4>
            <p>Payroll is now the source of truth for who works there. New starters, role changes and leavers flow from Affinity into Active Directory and Entra ID, and access to apps and reports is assigned by role and site. Where an app still needs setting up by hand, ServiceNow gets a ticket with the details filled in.</p>
          </div>
          <div>
            <h4>What changed</h4>
            <p>It's live in production. New starters' accounts are ready before their first day, and existing staff who needed accounts were brought in as well. Start and finish dates work across both countries' time zones, and executives who leave are handled by a flag on their record instead of a manual step.</p>
          </div>
        </div>
        <p class="case-link"><a href="/case-studies/industrial-australia-new-zealand/">Read the full case study, including what made it hard and how we handled it</a></p>
        <figure class="quote">
          <blockquote><p>Dubem and the team took on a complex payroll-to-identity project across Australia and New Zealand and delivered it exceptionally well from start to finish. Our new starters now have their accounts ready before day one, and the quirks in our data and leaver processes were properly worked through. Impeccable work, real attention to detail and genuine expertise.</p></blockquote>
          <figcaption>Head of IT, industrial business in Australia and New Zealand</figcaption>
        </figure>
      </article>
      <div class="work-grid">
        {work.map((w) => (
          <div class="work">
            <h3>{w.who}</h3>
            <p>{w.what}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="team">
      <h2 id="team">Who you'll work with</h2>
      <div class="team-grid">
        {TEAM.map((t) => (
          <div class="person">
            <img src={t.photo} alt={`Portrait of ${t.name}`} width="640" height="640" loading="lazy" />
            <div>
              <h3>{t.name}</h3>
              <p class="role">{t.role}</p>
              <p><a href={`/about/#${t.slug}`}>About {t.name.split(' ')[0]}</a></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="contact" aria-labelledby="talk">
      <h2 id="talk">Start with a conversation</h2>
      <p>The first conversation is free and takes about 45 minutes. We'll get to know your business and how people are set up today, talk through where we could help, and agree on sensible next steps.</p>
      <p class="contact-actions">
        <a class="button light" href={enquiry}>Email us your requirements</a>
        <a class="text-link" href={`mailto:${AUTHOR.email}`}>or email {AUTHOR.email}</a>
        {linkedin && <a class="text-link" href={linkedin} rel="me">or message {AUTHOR.name.split(' ')[0]} on LinkedIn</a>}
      </p>
    </section>
  </div>
</Base>

<style>
  .consult section {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .consult h2 {
    font-size: clamp(1.7rem, 3vw, 2.1rem);
    font-weight: 720;
  }

  .consult h3 {
    font-size: 1.15rem;
    font-weight: 680;
  }

  .section-lead {
    margin: 0.8rem 0 0;
    max-width: 40rem;
    color: var(--slate);
  }

  /* hero */
  .hero-c {
    padding-top: clamp(3rem, 8vw, 5.5rem);
  }

  .hero-c h1 {
    font-size: clamp(2.3rem, 5vw, 3.5rem);
    font-weight: 740;
    letter-spacing: -0.03em;
    line-height: 1.08;
    max-width: 22ch;
  }

  .hero-c p {
    max-width: 40rem;
    font-size: 1.22rem;
    color: var(--slate);
    margin: 1.4rem 0 0;
  }

  .hero-c .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.25rem;
  }

  .hero-c .proof {
    margin-top: 1.4rem;
    padding-left: 1rem;
    border-left: 3px solid var(--glacier);
    font-size: 1.08rem;
    color: var(--ink);
  }

  .proof a {
    font-family: var(--sans);
    font-weight: 600;
    white-space: nowrap;
  }

  .cta-note {
    font-family: var(--sans);
    font-size: 0.98rem;
    color: var(--slate);
  }

  .fit-list {
    max-width: 40rem;
    margin: 1.2rem 0 0;
    padding-left: 1.2rem;
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .fit-list li + li {
    margin-top: 0.35rem;
  }

  .button {
    display: inline-block;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 1.02rem;
    padding: 0.8rem 1.3rem;
    background: var(--ink);
    color: var(--frost);
    text-decoration: none;
    border-radius: 3px;
  }

  .button:hover {
    background: var(--glacier-deep);
    color: var(--frost);
    text-decoration: none;
  }

  .button.light {
    background: var(--frost);
    color: var(--ink);
  }

  .button.light:hover {
    background: #ffffff;
    color: var(--ink);
  }

  /* problems */
  .problem-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 3rem;
    margin-top: 2rem;
  }

  .problem {
    border-top: 2px solid var(--ink);
    padding: 1.1rem 0 1.6rem;
  }

  .problem p,
  .work p {
    margin: 0.45rem 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .aside {
    max-width: 40rem;
    margin: 1rem 0 0;
    font-size: 1.12rem;
  }

  /* lifecycle timeline */
  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.6rem;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 7px;
    /* stop at the last dot, which sits at the left edge of the last column */
    right: calc((100% - 4 * 1.6rem) / 5 - 9px);
    height: 2px;
    background: var(--glacier);
  }

  .timeline li {
    position: relative;
  }

  .timeline .dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--glacier);
    margin-bottom: 1.1rem;
    position: relative;
  }

  .timeline li:last-child .dot {
    background: var(--talon);
  }

  .timeline p {
    margin: 0.5rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }

  /* HR data split */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  .split p {
    margin: 1rem 0 0;
  }

  .caps {
    margin: 0.4rem 0 0;
  }

  .caps div {
    border-top: 1px solid var(--rule);
    padding: 1rem 0;
  }

  .caps div:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .caps dt {
    font-family: var(--sans);
    font-weight: 650;
    font-size: 1.08rem;
  }

  .caps dd {
    margin: 0.3rem 0 0;
    color: var(--slate);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  /* testimonial */
  .case {
    margin-top: 2rem;
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
  }

  .case h3 {
    font-size: clamp(1.3rem, 2.4vw, 1.55rem);
  }

  .case-meta {
    margin: 0.4rem 0 0;
    font-family: var(--sans);
    color: var(--slate);
    font-size: 1rem;
  }

  .case-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 3rem;
    margin-top: 1.4rem;
  }

  .case h4 {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--glacier-deep);
    margin: 0;
  }

  .case-body p {
    margin: 0.5rem 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .case-link {
    margin: 1.2rem 0 0;
    font-family: var(--sans);
    font-weight: 600;
  }

  .case .quote {
    border-top: 1px solid var(--rule);
  }

  .quote {
    margin: 2rem 0 1.5rem;
    max-width: 44rem;
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.6vw, 1.9rem);
    line-height: 1.35;
    font-style: italic;
    color: var(--ink);
  }

  .quote figcaption {
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--slate);
  }

  /* recent work */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin-top: 2rem;
  }

  .work {
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }

  /* team */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 3rem;
    margin-top: 2rem;
    max-width: 52rem;
  }

  .person {
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  .person img {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .person .role {
    margin: 0.2rem 0 0;
    font-family: var(--sans);
    color: var(--glacier);
    font-weight: 600;
  }

  .person p:last-child {
    margin: 0.6rem 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* contact band */
  .contact {
    background: var(--ink);
    color: var(--frost);
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 4px;
  }

  .contact h2 {
    color: var(--frost);
  }

  .contact p {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: #c9d6de;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.75rem !important;
  }

  .text-link {
    color: var(--frost);
    font-family: var(--sans);
  }

  .text-link:hover {
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .timeline {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 2rem;
    }

    .timeline::before {
      top: 4px;
      bottom: 1.5rem;
      left: 7px;
      right: auto;
      width: 2px;
      height: auto;
    }

    .timeline li {
      padding-bottom: 1.5rem;
    }

    .timeline .dot {
      position: absolute;
      left: -2rem;
      top: 4px;
    }

    .split {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .work-grid,
    .case-body,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .problem-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

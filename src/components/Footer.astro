---
import { AUTHOR, SITE } from '../config';
function labelFor(url: string) {
  if (url.includes('linkedin')) return 'LinkedIn';
  if (url.includes('github')) return 'GitHub';
  return new URL(url).hostname.replace('www.', '');
}
---
<footer class="site-footer">
  <div class="wrap">
    <p>{SITE.name} is a small identity governance consultancy in {AUTHOR.location.split(',')[0]}, co-founded by <a href="/about/">{AUTHOR.name}</a> and Lauren Battaglia. <a href="/consulting/">Work with us</a>. Client details in our articles are changed or removed.</p>
    <ul>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href={`mailto:${AUTHOR.email}`}>Email</a></li>
      {AUTHOR.sameAs.map((url) => <li><a href={url} rel="me">{labelFor(url)}</a></li>)}
    </ul>
  </div>
</footer>
